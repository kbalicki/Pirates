node_modules/
dist/
*.log
.DS_Store
*conflicted copy*

# Local temp files and assets
temp/
*.tmp

# Screenshots (dev only)
screenshot_*.png

# SD Pipeline - raw generated PNGs (large files)
sd-pipeline/assets_raw/**/*.png
sd-pipeline/assets_game/**/*.png
