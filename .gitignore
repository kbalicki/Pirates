node_modules/
dist/
*.log
.DS_Store
*conflicted copy*

# Local temp files and assets
temp/
*.tmp

# Screenshots (dev only)
screenshot_*.png

# SD Pipeline - raw generated PNGs (large files)
sd-pipeline/assets_raw/**/*.png
sd-pipeline/assets_game/**/*.png
# Keep metadata JSON files tracked
!sd-pipeline/assets_raw/**/*.json
sd-pipeline/assets_raw/**/*.gif
# Cloned tiled-diffusion repo (external dependency)
sd-pipeline/tools/tiled-diffusion/
# Temp test scripts
sd-pipeline/tools/_*.ps1

# AI assets - generated outputs (large files)
ai-assets/output/*.png
ai-assets/output/*.jpg
ai-assets/output/*.gif
# ...and in subdirectories: a generation batch is ~20 MB and is reproducible
# from ai-assets/scripts/ plus the manifest, which stays tracked.
ai-assets/output/**/*.png
ai-assets/output/**/*.jpg
ai-assets/output/**/*.gif
!ai-assets/output/**/manifest.json

# Claude settings — local only, EXCEPT the shared project skills
.claude/*
!.claude/skills/

# Python cache
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# OS files
Thumbs.db
Desktop.ini
